{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Contact</h1>

    {{ form_start(form) }}
        <div class="mb-3">
            {{ form_row(form.firstName) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.name) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.message) }}
        </div>
        <div class="mb-3">
            {{ form_row(form.send, {'attr': {'class': 'btn btn-primary'}}) }}
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}